# FastAPI 앱을 직접 실행하거나 배포할 때 필요하다.
# 테스트 스크립트는 이 값이 비어 있으면 `gh auth token`을 사용한다.
GITHUB_TOKEN=

# 주의: test_webhook_flow.sh를 실행하면 이 repository에 테스트 branch와 PR이 생성된다.
WEBHOOK_FROM_REPO_URL=https://github.com/inter403act/swm-17-ai-study
SMEE_URL=https://smee.io/commentory-swm17-temp-ai-tech-backend
RUN_SMEE_CLIENT=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
